{
  "name": "Laravel Sail Dev Container",
  "dockerComposeFile": "../compose.yml",
  "service": "laravel.test",
  "workspaceFolder": "/var/www/html",
  "shutdownAction": "stopCompose",
  "mounts": [
    "source=/run/user/1000/wayland-0,target=/tmp/wayland-0,type=bind,consistency=cached,required=false"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "onecentlin.laravel-blade",
        "bmewburn.vscode-laravel-extra-intellisense",
        "amiralayd.php-laravel-blade"
      ]
    }
  },
  "remoteUser": "sail"
}
